@baseUrl = http://localhost:8080

### Login as customer and save JWT automatically
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "john.customer@example.com",
  "password": "Helpdesk123!"
}

> {%
    client.test("Login succeeded", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200 but received " + response.status
        );

        client.assert(
            response.body.token,
            "The login response does not contain a token"
        );
    });

    client.global.set("auth_token", response.body.token);
%}

###

### Get all tickets using the saved JWT
GET {{baseUrl}}/tickets
Authorization: Bearer {{auth_token}}
Accept: application/json

> {%
    client.test("Authenticated ticket request succeeded", function () {
        client.assert(
            response.status === 200,
            "Expected HTTP 200 but received " + response.status
        );
    });
%}