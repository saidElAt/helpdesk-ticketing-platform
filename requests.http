@baseUrl = http://localhost:8080
@password = Helpdesk123!

### ============================================================================
### LOGIN
### ============================================================================

### Login as CUSTOMER
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "john.customer@example.com",
  "password": "{{password}}"
}

> {%
    client.global.set("customerToken", response.body.token);
    client.global.set("customerId", response.body.userId);
%}


### Login as AGENT
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "alice.agent@example.com",
  "password": "{{password}}"
}

> {%
    client.global.set("agentToken", response.body.token);
    client.global.set("agentId", response.body.userId);
%}


### Login as ADMIN
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@example.com",
  "password": "{{password}}"
}

> {%
    client.global.set("adminToken", response.body.token);
    client.global.set("adminId", response.body.userId);
%}



### ============================================================================
### CATEGORIES
### ============================================================================

### Get Categories

GET {{baseUrl}}/categories
Authorization: Bearer {{customerToken}}
Accept: application/json



### ============================================================================
### TICKETS
### ============================================================================

### Get all tickets

GET {{baseUrl}}/tickets
Authorization: Bearer {{customerToken}}
Accept: application/json


### Get ticket by id

GET {{baseUrl}}/tickets/4
Authorization: Bearer {{customerToken}}
Accept: application/json


### Create ticket

POST {{baseUrl}}/tickets
Authorization: Bearer {{customerToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Unable to access customer account",
  "description": "The account login page rejects the customer's valid credentials.",
  "priority": "HIGH",
  "customerId": 1,
  "categoryId": 1
}

> {%
    client.global.set("ticketId", response.body.id);
%}


### Create invalid ticket

POST {{baseUrl}}/tickets
Authorization: Bearer {{customerToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "",
  "description": "",
  "priority": null,
  "customerId": null,
  "categoryId": null
}


### Update ticket

PUT {{baseUrl}}/tickets/4
Authorization: Bearer {{agentToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Updated account access issue",
  "description": "Customer still cannot access the account after password reset.",
  "priority": "MEDIUM"
}


### Assign ticket

PATCH {{baseUrl}}/tickets/4/assign/2
Authorization: Bearer {{adminToken}}
Accept: application/json


### Change ticket status

PATCH {{baseUrl}}/tickets/4/status
Authorization: Bearer {{agentToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "RESOLVED"
}


### Get ticket after changes

GET {{baseUrl}}/tickets/4
Authorization: Bearer {{customerToken}}
Accept: application/json



### ============================================================================
### COMMENTS
### ============================================================================

### Create customer comment

POST {{baseUrl}}/tickets/4/comments
Authorization: Bearer {{customerToken}}
Content-Type: application/json
Accept: application/json

{
  "authorId": 1,
  "content": "I still cannot access my account after resetting the password."
}


### Create agent comment

POST {{baseUrl}}/tickets/4/comments
Authorization: Bearer {{agentToken}}
Content-Type: application/json
Accept: application/json

{
  "authorId": 2,
  "content": "I am investigating the authentication logs and account configuration."
}


### Get comments

GET {{baseUrl}}/tickets/4/comments
Authorization: Bearer {{customerToken}}
Accept: application/json


### Create invalid comment

POST {{baseUrl}}/tickets/4/comments
Authorization: Bearer {{customerToken}}
Content-Type: application/json
Accept: application/json

{
  "authorId": 1,
  "content": ""
}


### Create comment on non-existent ticket

POST {{baseUrl}}/tickets/999/comments
Authorization: Bearer {{customerToken}}
Content-Type: application/json
Accept: application/json

{
  "authorId": 1,
  "content": "This should fail."
}



### ============================================================================
### STATUS HISTORY
### ============================================================================

### Change ticket to IN_PROGRESS

PATCH {{baseUrl}}/tickets/4/status
Authorization: Bearer {{agentToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "IN_PROGRESS"
}


### Change ticket to RESOLVED

PATCH {{baseUrl}}/tickets/4/status
Authorization: Bearer {{agentToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "RESOLVED"
}


### Get ticket status history

GET {{baseUrl}}/tickets/4/history
Authorization: Bearer {{customerToken}}
Accept: application/json



### ============================================================================
### DELETE
### ============================================================================

### Delete ticket

DELETE {{baseUrl}}/tickets/4
Authorization: Bearer {{adminToken}}


### Delete non-existent ticket

DELETE {{baseUrl}}/tickets/999
Authorization: Bearer {{adminToken}}