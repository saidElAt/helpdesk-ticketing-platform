@baseUrl = http://localhost:8080
@password = Helpdesk123!

### ============================================================================
### AUTHENTICATION
### ============================================================================

### Login as CUSTOMER
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "john.customer@example.com",
  "password": "{{password}}"
}

> {%
    client.global.set("customerToken", response.body.token);
    client.global.set("customerId", response.body.userId);
%}


### Login as AGENT
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "alice.agent@example.com",
  "password": "{{password}}"
}

> {%
    client.global.set("agentToken", response.body.token);
    client.global.set("agentId", response.body.userId);
%}


### Login as ADMIN
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@example.com",
  "password": "{{password}}"
}

> {%
    client.global.set("adminToken", response.body.token);
%}


### ============================================================================
### CREATE TEST TICKET
### ============================================================================

### Create ticket
POST {{baseUrl}}/tickets
Authorization: Bearer {{customerToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Corporate VPN connection failure",
  "description": "The customer cannot establish a connection to the corporate VPN.",
  "priority": "HIGH",
  "customerId": {{customerId}},
  "categoryId": 4
}

> {%
    client.global.set("ticketId", response.body.id);
%}


### ============================================================================
### SEARCH AND FILTERING
### ============================================================================

### List all tickets
GET {{baseUrl}}/tickets
Authorization: Bearer {{customerToken}}
Accept: application/json


### Search title and description
GET {{baseUrl}}/tickets?search=VPN
Authorization: Bearer {{customerToken}}
Accept: application/json


### Filter by status
GET {{baseUrl}}/tickets?status=OPEN
Authorization: Bearer {{customerToken}}
Accept: application/json


### Filter by priority
GET {{baseUrl}}/tickets?priority=HIGH
Authorization: Bearer {{customerToken}}
Accept: application/json


### Filter by category
GET {{baseUrl}}/tickets?categoryId=4
Authorization: Bearer {{customerToken}}
Accept: application/json


### Filter by customer
GET {{baseUrl}}/tickets?customerId={{customerId}}
Authorization: Bearer {{customerToken}}
Accept: application/json


### Combined filters
GET {{baseUrl}}/tickets?search=VPN&status=OPEN&priority=HIGH&categoryId=4&customerId={{customerId}}
Authorization: Bearer {{customerToken}}
Accept: application/json


### Assign ticket
PATCH {{baseUrl}}/tickets/{{ticketId}}/assign/{{agentId}}
Authorization: Bearer {{adminToken}}
Accept: application/json


### Filter by assigned agent
GET {{baseUrl}}/tickets?assignedAgentId={{agentId}}
Authorization: Bearer {{agentToken}}
Accept: application/json


### ============================================================================
### DASHBOARD AND REPORTING
### ============================================================================

### Dashboard as AGENT
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{agentToken}}
Accept: application/json


### Dashboard as CUSTOMER
### Expected: 403
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{customerToken}}
Accept: application/json


### Ticket report as ADMIN
GET {{baseUrl}}/reports/tickets/summary
Authorization: Bearer {{adminToken}}
Accept: application/json


### ============================================================================
### OPENAPI DOCUMENTATION
### ============================================================================

### Download OpenAPI document
GET {{baseUrl}}/openapi.yaml
Accept: application/yaml


### ============================================================================
### STATUS HISTORY
### ============================================================================

### Change status
PATCH {{baseUrl}}/tickets/{{ticketId}}/status
Authorization: Bearer {{agentToken}}
Content-Type: application/json
Accept: application/json

{
  "status": "RESOLVED"
}


### Get status history
GET {{baseUrl}}/tickets/{{ticketId}}/history
Authorization: Bearer {{customerToken}}
Accept: application/json


### ============================================================================
### CLEANUP
### ============================================================================

### Delete test ticket
DELETE {{baseUrl}}/tickets/{{ticketId}}
Authorization: Bearer {{adminToken}}